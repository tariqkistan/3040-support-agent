# Copy to .env and fill in. NO Azure keys/secrets belong here — all Azure
# access uses DefaultAzureCredential (Entra ID). The only secret is the
# API key for THIS service's own endpoint.

# --- Required: Microsoft Foundry project ---
# Endpoint of your Foundry project (from the Foundry portal, e.g.
# https://<resource>.services.ai.azure.com/api/projects/<project>)
AZURE_AI_PROJECT_ENDPOINT=

# Model deployment name in the project used by the agent (e.g. gpt-4o,
# gpt-5-mini). Instant Foundry models need no deployment.
AGENT_MODEL_DEPLOYMENT=

# Azure OpenAI endpoint of the Foundry resource — where custom deployments
# (embeddings, eval judge) actually live:
# https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# --- Required: Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=support-docs
# Name of the Azure AI Search connection configured on the Foundry project
AZURE_SEARCH_CONNECTION_NAME=
# Retrieval mode. Free tier has no semantic ranker -> vector_simple_hybrid.
# Paid tiers can use vector_semantic_hybrid.
SEARCH_QUERY_TYPE=vector_simple_hybrid

# --- Required: this API's own key (NOT an Azure key) ---
# Any long random string you choose, e.g. `openssl rand -hex 32`
APP_API_KEY=

# --- Conversation storage ---
# Use memory only for local development. Hosted instances should use Cosmos DB.
SESSION_STORE_BACKEND=memory
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=support-agent
AZURE_COSMOS_CONTAINER=agent-sessions
# Conversation mappings expire after 30 days.
SESSION_TTL_SECONDS=2592000

# --- Optional ---
# Max chars accepted in a chat message (default 4000)
MAX_MESSAGE_LENGTH=4000
# Requests per minute per connector key (default 30; in-process limiter)
RATE_LIMIT_PER_MINUTE=30
# Vector index dimensions — must match your embedding deployment
# (text-embedding-3-small: 1536; text-embedding-3-large: 3072)
EMBEDDING_DIMENSIONS=1536
# Embedding model deployment name on the AOAI resource (for ingest vectorization)
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-small
# Judge deployment for evals. MUST be a non-reasoning model (e.g. gpt-4.1-mini)
# — azure-ai-evaluation calls chat.completions with max_tokens, which
# reasoning models like gpt-5-mini reject.
EVAL_MODEL_DEPLOYMENT=gpt-4.1-mini

# --- Only if the PDF is scanned (see ingest/inspect_pdf.py output) ---
# DOCUMENT_INTELLIGENCE_ENDPOINT=
