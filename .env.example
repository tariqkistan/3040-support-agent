# Copy to .env and fill in. NO Azure keys/secrets belong here — all Azure
# access uses DefaultAzureCredential (Entra ID). The only secret is the
# API key for THIS service's own endpoint.

# --- Required: Microsoft Foundry project ---
# Endpoint of your Foundry project (from the Foundry portal, e.g.
# https://<resource>.services.ai.azure.com/api/projects/<project>)
AZURE_AI_PROJECT_ENDPOINT=

# Model deployment name in the project used by the agent (e.g. gpt-4o)
AGENT_MODEL_DEPLOYMENT=

# --- Required: Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=support-docs
# Name of the Azure AI Search connection configured on the Foundry project
AZURE_SEARCH_CONNECTION_NAME=

# --- Required: this API's own key (NOT an Azure key) ---
# Any long random string you choose, e.g. `openssl rand -hex 32`
APP_API_KEY=

# --- Optional ---
# Max chars accepted in a chat message (default 4000)
MAX_MESSAGE_LENGTH=4000
# Requests per minute per client IP (default 30)
RATE_LIMIT_PER_MINUTE=30
# Vector index dimensions — must match your embedding deployment
# (text-embedding-3-large default: 3072; -3-small: 1536)
EMBEDDING_DIMENSIONS=3072
# Embedding model deployment name on the project (for ingest vectorization)
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-large

# --- Only if the PDF is scanned (see ingest/inspect_pdf.py output) ---
# DOCUMENT_INTELLIGENCE_ENDPOINT=
